# Google Sheets
GOOGLE_SHEET_ID=replace_with_spreadsheet_id
GOOGLE_SHEET_NAME=Sheet1
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Authentication: use a long random secret (at least 32 characters)
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Exact public origin of your frontend, e.g. https://gameonix.example.com
FRONTEND_URL=http://localhost:5173